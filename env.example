# Copy to .env.development or .env.production
VITE_API_BASE_URL=http://localhost:3000

# App token from primary-admin → Tenant → App Management (required for self-register and unauthenticated API calls)
VITE_APP_TOKEN=

# Public base URL for referral invite links (display only; API returns canonical link from tenant settings)
# VITE_REFERRAL_LINK_BASE=https://rupee.life

# Google OAuth (@capawesome/capacitor-google-sign-in + Web GIS).
# Web client: required for native initialize({ clientId }) on Android/iOS and for browser GIS.
# Android client: register package com.rupeelife.app + SHA-1 in Google Cloud only (not passed to the plugin).
# iOS client: set GIDClientID in ios/App/App/Info.plist when you add the iOS project.
# The same Web/iOS/Android IDs must be listed in auth-service GOOGLE_CLIENT_ID (comma-separated).
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=
VITE_GOOGLE_ANDROID_CLIENT_ID=

# Set to 1 for release APK logcat debugging (filter Logcat by "GoogleAuth")
# VITE_GOOGLE_AUTH_DEBUG=1
